# Aloxberry bridge — nginx-proxy deployment environment.
# Copy to .env on the deployment host and fill in real values.
# DO NOT commit .env to git (the example file is the only thing in version control).

# --- TLS / hostname ----------------------------------------------------------

# Public hostname for the bridge. Must have an A/AAAA record pointing at the
# host running nginx-proxy (= the GKS server). acme-companion obtains a
# Let's Encrypt cert for this name automatically when the container starts.
ALOXBERRY_BRIDGE_HOSTNAME=loxhome-bridge.net

# Email for ACME registration. Empty falls back to nginx-proxy-letsencrypt's
# DEFAULT_EMAIL setting. Set explicitly if you want bridge cert renewal mail separated.
ACME_EMAIL=martin@korndoerfer.de

# --- bridge ------------------------------------------------------------------

# Shared secret with the AWS Lambda. MUST match the value stored in
# AWS SSM at /loxberry-alexa/bridge-dispatch-secret (eu-west-1). Used in
# both directions: Lambda → bridge sets X-Bridge-Auth on every /dispatch
# call (bridge rejects without it); bridge → Lambda sets it on every
# /event POST (Phase 4 outbound). 32+ random bytes. Generate with:
#   openssl rand -base64 32
#   # or:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BRIDGE_DISPATCH_SECRET=

# Lambda /event endpoint — where the bridge POSTs proactive ChangeReports
# the daemon sends over WSS (Phase 4 outbound). Construct from the SAM
# stack output `OAuthBaseUrl` + `/event`. Example:
#   LAMBDA_EVENT_URL=https://abcd1234ef.execute-api.eu-west-1.amazonaws.com/event
# Leave empty during initial bring-up; bridge silently drops reports when
# unset. (Phase 4 outbound only — directive dispatch in the opposite
# direction does not need this URL because Lambda has BRIDGE_URL.)
LAMBDA_EVENT_URL=

# Log level: trace | debug | info | warn | error | fatal
LOG_LEVEL=info
