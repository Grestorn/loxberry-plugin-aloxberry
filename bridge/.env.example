# Aloxberry bridge — operator-supplied environment.
# Copy to .env and fill in real values before `docker compose up`.

# --- TLS / hostname ----------------------------------------------------------

# Public hostname clients reach the bridge at. Must have a DNS A/AAAA record
# pointing at the host running this docker-compose stack. Caddy obtains a
# Let's Encrypt cert for this hostname on first start.
ALOXBERRY_BRIDGE_HOSTNAME=

# ACME notification email. Optional but recommended — Let's Encrypt sends
# expiry/renewal-failure mail here. Leave blank for the anonymous flow.
ACME_EMAIL=

# HTTPS port the bridge serves on. Defaults to 443 (commented out below
# uses the default). Override (e.g. 8443) when running alongside another
# service that already owns 443 — common on NAS deployments where the
# NAS UI occupies 443.
#
# Port 80 is ALWAYS required for Let's Encrypt's HTTP-01 challenge
# regardless of HTTPS_PORT. If 80 is also taken on your host, see the
# "Running on a NAS / alt-port deployment" section of README.md.
#
# When you change this, also update the bridge URL pasted into Alexa's
# OAuth form to include the port — e.g. https://bridge.example.com:8443
#HTTPS_PORT=443

# --- bridge ------------------------------------------------------------------

# Shared secret with the AWS Lambda. Used in both directions:
#   - Lambda → bridge sets `X-Bridge-Auth` on every /dispatch + /probe call.
#   - Bridge → Lambda sets it on every /event POST (Phase 4 outbound).
# 32+ random bytes. Generate with:
#   openssl rand -base64 32
#   # or:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Store the SAME value in AWS SSM SecureString at
# /loxberry-alexa/bridge-dispatch-secret.
BRIDGE_DISPATCH_SECRET=

# Lambda /event endpoint — where the bridge POSTs proactive ChangeReports
# the daemon sends over WSS (Phase 4 outbound). Construct from the SAM
# stack output `OAuthBaseUrl` + `/event`. Example:
#   LAMBDA_EVENT_URL=https://abcd1234ef.execute-api.eu-west-1.amazonaws.com/event
# Leave empty during initial bring-up; the bridge silently drops reports
# when unset, and the daemon stays up. Inbound directives (the opposite
# direction) don't need this URL.
LAMBDA_EVENT_URL=

# Log level: trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# --- bridge tunables (optional) ---------------------------------------------
# Defaults are fine for most operators. Adjust only if your intermediary
# (corp proxy, CDN) imposes a tighter idle WS timeout than 30s.

# HELLO_TIMEOUT_MS=5000           # Plugin must send `hello` within this window
# HEARTBEAT_INTERVAL_MS=30000     # App-layer ping cadence
# PONG_TIMEOUT_MS=60000           # Plugin must pong within this window
# DISPATCH_TIMEOUT_MS=10000       # Lambda must get a plugin response within this

# --- pair-code TTL (certification override) ---------------------------------
# How long a published pair code stays redeemable, in milliseconds. Leave
# UNSET for normal operation — the bridge falls back to its built-in
# 10-minute default (see bridge/src/pair.js). The code is one-shot regardless;
# a longer TTL only widens the pre-redemption window.
#
# Set this ONLY for a time-boxed Alexa certification review, where an external
# reviewer needs a long-lived code, then clear it once certification is done.
#   259200000 = 72h   (typical cert-review window)
#PAIR_TTL_MS=259200000
